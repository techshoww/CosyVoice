      {
        "layer_name": "/m_source/l_sin_gen/Transpose_2",
        "data_type": "FP32"
      },
      {
        "layer_name": "/m_source/l_sin_gen/Transpose_3",
        "data_type": "FP32"
      },
      {
        "layer_name": "/m_source/l_sin_gen/Mul",
        "data_type": "FP32"
      },
    ]
  },

  "compiler": {
    "npu_perf": false
  }
